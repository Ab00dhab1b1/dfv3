function hurt(dmg,sx,sz){if(inv>0||dash>0||hp<=0)return;const dx=sx-P.position.x,dz=sz-P.position.z,d=H(dx,dz)||1,f=fwd();if(blk&&(f[0]*dx+f[1]*dz)/d>.1)dmg*=.15;hp-=dmg;inv=.35;pf=.15;pm.forEach(m=>m.emissive.setHex(0x771111))}
function flash(e,c){e.mats.forEach(m=>m.emissive.setHex(c))}
function strike(){const f=fwd();E.forEach(e=>{if(e.dead)return;const dx=e.g.position.x-P.position.x,dz=e.g.position.z-P.position.z,d=H(dx,dz)||1;
 if(d<4.4+e.r&&((f[0]*dx+f[1]*dz)/d>.2||d<e.r+1)){e.hp-=10;e.fl=.12;flash(e,0x992222);if(!e.big){e.kx=dx/d*10;e.kz=dz/d*10}
  if(e.hp<=0){e.dead=1;e.dt=0;if(e.k=='kn'){won=1;say('THE FALLEN KNIGHT FALLS — YOU WIN!',1e9)}}}})}
function aim(){let b=null,bd=11;E.forEach(e=>{if(e.dead)return;const d=H(e.g.position.x-P.position.x,e.g.position.z-P.position.z)-e.r;if(d<bd){bd=d;b=e}});if(b)P.rotation.y=M.atan2(b.g.position.x-P.position.x,b.g.position.z-P.position.z)}
function fire(e,col,gk,spd,dmg,n,sp){const ex=e.g.position.x,ez=e.g.position.z,a0=M.atan2(P.position.x-ex,P.position.z-ez);
 for(let i=0;i<n;i++){const a=a0+(i-(n-1)/2)*sp,m=new T.Mesh(geo[gk],new T.MeshBasicMaterial({color:col}));gk=='sph'?m.scale.setScalar(.6):m.scale.set(.3,.9,.3);m.position.set(ex+S(a)*e.r,1.4,ez+C(a)*e.r);sc.add(m);PR.push({m,vx:S(a)*spd,vz:C(a)*spd,dmg,life:4,sp:gk=='oct'})}}
function ai(e,dt){const g=e.g,p=g.position;const dx=P.position.x-p.x,dz=P.position.z-p.z,d=H(dx,dz)||1,ux=dx/d,uz=dz/d;
 g.visible=d<95;
 if(e.dead){e.dt+=dt;p.y-=dt*(e.big?2:.3);if(!e.big)g.rotation.x=M.min(e.dt*4,1.5);return}
 if(d>95)return;
 if(e.fl>0){e.fl-=dt;if(e.fl<=0)flash(e,0)}
 p.x+=e.kx*dt;p.z+=e.kz*dt;e.kx*=.85;e.kz*=.85;e.cd-=dt;
 const face=()=>g.rotation.y=M.atan2(ux,uz),mv=s=>{p.x+=ux*s*dt;p.z+=uz*s*dt};
 if(e.k=='sk'){let w=0;if(d<22&&!e.st){face();if(d>2.2){mv(e.sp);w=1}else if(e.cd<=0){e.st=1;e.t=.5}}
  e.legs[0][0].rotation.x=S(tt*10)*.6*w;e.legs[1][0].rotation.x=-S(tt*10)*.6*w;e.legs[0][1].rotation.x=M.max(0,C(tt*10))*.8*w;e.legs[1][1].rotation.x=M.max(0,-C(tt*10))*.8*w;
  if(e.st){e.t-=dt;e.arm.rotation.x=-2.2+(1-e.t/.5)*2.6;e.elb.rotation.x=-.2;if(e.t<=0){if(d<2.8)hurt(8,p.x,p.z);e.st=0;e.cd=1.3}}else{e.arm.rotation.x=-.3;e.elb.rotation.x=-.6}return}
 if(d>60)return;face();
 if(e.k=='wz'||e.k=='wi'){const keep=e.k=='wz'?11:15;if(d>keep+3)mv(e.sp);else if(d<keep-4)mv(-e.sp);
  if(e.k=='wi')p.y=1+S(tt*2)*.4;
  if(e.cd<=0){e.k=='wz'?fire(e,0xff6a1a,'sph',14,12,1,0):fire(e,0x8ae8ff,'oct',12,10,3,.25);e.cd=e.k=='wz'?2.2:2.6}return}
 // knight + samurai melee
 e.cs-=dt;e.t-=dt;
 if(e.st==0){if(d<e.rr&&e.cs<=0){e.st=4;e.t=.7}else if(d>e.rr+4&&e.cd<=0){e.st=1;e.t=.9;e.cd=4}else if(d>e.rr-2)mv(e.sp)}
 else if(e.st==1){flash(e,S(tt*30)>0?0x660000:0);if(e.t<=0){e.dx=ux;e.dz=uz;e.st=2;e.t=1.1;e.hit=0}}
 else if(e.st==2){g.rotation.y=M.atan2(e.dx,e.dz);p.x+=e.dx*26*dt;p.z+=e.dz*26*dt;if(!e.hit&&d<e.r+1.4){hurt(e.cdm,p.x,p.z);e.hit=1}if(e.t<=0){e.st=3;e.t=.9;flash(e,0)}}
 else if(e.st==3){if(e.t<=0)e.st=0}
 else if(e.st==4){e.arm.rotation.x=-2.2+(1-e.t/.7)*2.6;if(e.t<=0){if(d<e.rr+1)hurt(e.sd,p.x,p.z);e.st=3;e.t=.8;e.cs=1.8}}
 if(e.st!=4)e.arm.rotation.x=-.3;if(e.elb)e.elb.rotation.x=e.st==4?-.2:-.5}

function step(dt){tt+=dt;
 if(hp>0){let a=(k.KeyD?1:0)-(k.KeyA?1:0),b=(k.KeyW?1:0)-(k.KeyS?1:0);const ml=H(a,b);if(ml){a/=ml;b/=ml}
  const mx=a*C(yaw)-b*S(yaw),mz=-a*S(yaw)-b*C(yaw);
  blk=k.KeyB&&sw<=0;
  if(want.dash&&dashCd<=0&&!blk){dash=.18;dashCd=.8;dd=ml?[mx,mz]:fwd()}
  if(want.swing&&sw<=0&&!blk){sw=.001;hitDone=0;aim()}
  want.dash=want.swing=0;dashCd-=dt;inv-=dt;
  let vx=mx,vz=mz,s=7*(blk?.4:1)*(sw>0?.5:1);if(dash>0){dash-=dt;vx=dd[0];vz=dd[1];s=26}
  P.position.x+=vx*s*dt;P.position.z+=vz*s*dt;if(ml&&!sw&&dash<=0)P.rotation.y=M.atan2(mx,mz);
  P.position.x=M.max(-497,M.min(497,P.position.x));P.position.z=M.max(-247,M.min(247,P.position.z));
  ob.forEach(o=>{const dx=P.position.x-o[0],dz=P.position.z-o[1];if(M.abs(dx)>10||M.abs(dz)>10)return;const d=H(dx,dz)||.01;if(d<o[2]+.5){P.position.x=o[0]+dx/d*(o[2]+.5);P.position.z=o[1]+dz/d*(o[2]+.5)}});
  const w=(ml&&dash<=0)?1:0,ph=S(tt*12)*w;legL[0].rotation.x=ph*.6;legR[0].rotation.x=-ph*.6;legL[1].rotation.x=M.max(0,C(tt*12))*.9*w;legR[1].rotation.x=M.max(0,-C(tt*12))*.9*w;armL.rotation.x=-ph*.5;elbL.rotation.x=-.3-w*.3;
  if(sw>0){sw+=dt;if(!hitDone&&sw>.16){hitDone=1;strike()}if(sw>.32)sw=0}
  arm.rotation.x=sw>0?-2.4+M.min(sw/.32,1)*2.8:blk?-1:-.2+S(tt*2)*.04;elb.rotation.x=sw>0?-.2:blk?-.57:-.5;
  hp=M.min(MH,hp+dt*1.5)
 }else if(!dying){dying=1;say('YOU DIED',2200);setTimeout(()=>{hp=MH;P.position.set(-375,0,133);dying=0},2300)}
 if(pf>0){pf-=dt;if(pf<=0)pm.forEach(m=>m.emissive.setHex(0))}
 E.forEach(e=>ai(e,dt));E=E.filter(e=>e.dt<2);
 for(let i=PR.length-1;i>=0;i--){const p=PR[i];p.m.position.x+=p.vx*dt;p.m.position.z+=p.vz*dt;p.life-=dt;if(p.sp)p.m.rotation.y+=dt*8;
  if(H(p.m.position.x-P.position.x,p.m.position.z-P.position.z)<1.1&&hp>0){hurt(p.dmg,p.m.position.x-p.vx,p.m.position.z-p.vz);p.life=0}
  if(p.life<=0){sc.remove(p.m);PR.splice(i,1)}}
 const z=Z[zAt(P.position.x,P.position.z)];sc.fog.color.lerp(new T.Color(z[1]),dt*2);sc.background.copy(sc.fog.color);sc.fog.far+=(z[2]-sc.fog.far)*dt*2;amb.intensity+=(z[6]-amb.intensity)*dt*2;
 $('zn').textContent=z[0];$('hp').style.width=M.max(0,hp)/MH*100+'%';
 let bs=null,tz=1;E.forEach(e=>{if(e.big&&!e.dead&&H(e.g.position.x-P.position.x,e.g.position.z-P.position.z)<45){bs=e;tz=e.k=='kn'?1.5:e.k=='wi'?1.5:1.25}});
 $('bn').textContent=bs?bs.name:'';$('bb').style.display=bs?'block':'none';if(bs)$('bh').style.width=bs.hp/bs.mx*100+'%';
 cz+=(tz-cz)*dt*2;const cd=zd*cz;cam.position.lerp(new T.Vector3(P.position.x+S(yaw)*C(pit)*cd,1.5+S(pit)*cd,P.position.z+C(yaw)*C(pit)*cd),.25);cam.lookAt(P.position.x,2,P.position.z)}

addEventListener('keydown',e=>{if(e.code=='Space')e.preventDefault();k[e.code]=1;if(e.repeat)return;
 if(e.code=='Space')want.swing=1;if(e.code=='KeyK')want.dash=1;if(e.code=='Digit1')setO(0);if(e.code=='Digit2')setO(1);if(e.code=='Digit3')setO(2)});
addEventListener('keyup',e=>k[e.code]=0);
addEventListener('mousemove',e=>{if(run&&(document.pointerLockElement||e.buttons)){yaw-=e.movementX*.005;pit=M.max(.1,M.min(1.4,pit+e.movementY*.004))}});
addEventListener('wheel',e=>{zd=M.max(6,M.min(45,zd+e.deltaY*.02))},{passive:true});
rd.domElement.addEventListener('click',()=>{try{run&&rd.domElement.requestPointerLock()}catch(x){}});
function go(){$('ov').style.display='none';run=1;document.activeElement.blur()}
let last=0;(function loop(ts){requestAnimationFrame(loop);const dt=M.min(.05,(ts-last)/1000||0);last=ts;if(run)step(dt);rd.render(sc,cam)})(0);
</script></body></html>
